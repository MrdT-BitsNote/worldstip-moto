<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>宁远九嶷山舜帝陵“华夏第一陵”祭祖线</name>
    <desc>九嶷山舜帝陵位于宁远县九嶷山瑶族乡，是中华民族始祖“五帝”之一舜帝的陵庙，被誉为“华夏第一陵”，占地 5 万平方米、三面宫墙环绕，有玉带桥、仪门、神道、拜殿、正殿与碑廊；九嶷山又名苍梧山，群峰朝拜舜源峰，有紫霞岩（楚南名洞之首）、三分石与摩崖石刻。本线从零陵古城南行深入九嶷山，探访舜帝陵、紫霞岩与舜源峰，是永州最具分量的祭祖寻根骑游，单程约 130km、建议安排两天。</desc>
    <time>2026-10-16T08:00:00.875869+00:00</time>
  </metadata>
  <wpt lat="26.21437" lon="111.60569">
    <name>零陵古城</name>
  </wpt>
  <wpt lat="25.355" lon="111.98462">
    <name>舜帝陵景点</name>
  </wpt>
  <wpt lat="25.34713" lon="111.97995">
    <name>紫霞岩景区售票处</name>
  </wpt>
