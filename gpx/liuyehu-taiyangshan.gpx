<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>柳叶湖·太阳山环湖爬坡休闲线</name>
    <desc>常德经典的城市近郊环湖+爬坡休闲线，先环柳叶湖（水域约 3 倍西湖）兜风，再挑战太阳山森林公园的“魔鬼坡道”（骑友称“陡的不敢第二次骑”），登顶普光寺俯瞰柳叶湖全貌。环湖约 35km、爬升 400-500m，是常德骑手刷圈与练坡的招牌路线，湖边风大记得带防风镜。</desc>
    <time>2026-10-16T08:00:01.317045+00:00</time>
  </metadata>
  <wpt lat="29.05136" lon="111.74382">
    <name>柳叶湖旅游度假区</name>
  </wpt>
