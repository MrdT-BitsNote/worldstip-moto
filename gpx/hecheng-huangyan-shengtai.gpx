<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>鹤城黄岩生态旅游区“怀化庐山”近郊休闲线</name>
    <desc>黄岩生态旅游区位于鹤城区东南郊（中方县黄岩），为典型的喀斯特高山台地，平均海拔 850 米，素有“高山净地”“叠翠画廊”“怀化庐山”之美誉，距怀化城区不到 20 公里，气温常年比市区低 5-7℃，是避暑消夏打卡地，有高空滑索与白马村林海。本线在迎丰公园与黄岩之间沿山区乡道兜风，青山林海相伴、绿地开阔、林深树密，是市区骑手周末避暑、露营、赏景的轻松去处，也是怀化本地骑行攻略的经典郊野段，单程约 22km、环回约 44km。</desc>
    <time>2026-10-16T07:59:59.851596+00:00</time>
  </metadata>
  <wpt lat="27.56083" lon="109.98558">
    <name>迎丰公园</name>
