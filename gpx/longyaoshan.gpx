<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>临湘龙窖山·龙窖湖瑶族文化线</name>
    <desc>龙窖山位于临湘市东南部，是瑶族千家洞文化的发源地之一，被瑶族同胞视为”瑶族故土”；山中有龙窖湖、瑶族古遗址、石窝洞等历史遗迹，千年瑶族文化在此留存。本线从岳阳市区东北行至临湘，深入龙窖山探访瑶族文化源头与龙窖湖山水，全程约 90km，是一次融合瑶族历史、山林湖泊与湘鄂边区民俗的人文骑游。</desc>
    <time>2026-10-16T08:00:01.947335+00:00</time>
  </metadata>
  <wpt lat="29.37384" lon="113.09302">
    <name>巴陵广场</name>
  </wpt>
