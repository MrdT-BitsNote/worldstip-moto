<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>耒阳蔡伦竹海万亩竹浪线</name>
    <desc>蔡伦竹海位于耒阳，面积约 16 万亩、是亚洲最大连片竹海，因纪念造纸术发明家蔡伦得名，景区内“竹海石林”为全球唯一连片白砂岩地貌，登顶观海楼可览“竹浪翻涌”奇观，还有竹海瀑布（落差约 30 米）与古法造纸遗址。本线从衡阳东南行经耒阳，串联蔡伦纪念园、蔡伦故里与蔡伦竹海，是一次造纸文化+万亩竹海的自然人文长途骑游，全程约 100km，建议早出发、可宿耒阳。</desc>
    <time>2026-10-16T08:00:00.139017+00:00</time>
  </metadata>
  <wpt lat="26.87456" lon="112.66958">
    <name>酃湖公园</name>
