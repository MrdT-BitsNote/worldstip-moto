<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>衡南石牛峰原始森林线</name>
    <desc>石牛峰（又名十牛峰）位于衡南县，以奇峰怪石与原始森林著称，是衡阳小众的徒步与生态目的地。本线从衡阳城南集合点南下约 25km 进入衡南丘陵山区，沿途乡村公路弯绕、林木渐密，抵达石牛峰景区后可徒步登顶赏奇峰怪石与原始次生林。山路弯多坡陡、路窄，建议结伴、控速，山顶以徒步为主、摩托停景区/山脚。</desc>
    <time>2026-10-16T08:00:00.134199+00:00</time>
  </metadata>
  <wpt lat="26.83999" lon="112.62729">
    <name>衡阳植物园</name>
  </wpt>
  <wpt lat="26.76815" lon="112.49666">
    <name>石牛峰</name>
  </wpt>
