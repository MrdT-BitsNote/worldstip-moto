<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>双牌阳明山国家森林公园盘山杜鹃云海线</name>
    <desc>阳明山国家森林公园位于双牌县东北隅、属五岭山脉，1992 年获批国家森林公园，自古被誉为“人间灵山福地”，主峰望佛台海拔逾 1600 米，拥有万亩杜鹃花海、万和湖、万寿寺与小黄江源瀑布群，五月初杜鹃漫山遍野、夏季清凉避暑、秋冬云雾翻腾。本线从零陵古城东行盘山深入阳明山，行走“山高水秀林木茂密”的盘山公路直达公园，是永州最经典的高山森林攻山压弯线，上山弯多坡长、新手注意。</desc>
    <time>2026-10-16T08:00:00.827834+00:00</time>
  </metadata>
  <wpt lat="26.21437" lon="111.60569">
    <name>零陵古城</name>
  </wpt>
  <wpt lat="26.07276" lon="111.92567">
    <name>阳明山国家森林公园</name>
  </wpt>
