<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>衡东罗荣桓元帅故里红色线</name>
    <desc>罗荣桓元帅故里位于衡东县荣桓镇南湾村，建有罗荣桓故居与纪念馆，是全国重要的革命纪念地与爱国主义教育示范基地。本线从衡阳东行约 65km 抵达衡东荣桓镇，瞻仰元帅故居与纪念馆，沿途为湘东丘陵田园，是衡阳东向的红色人文骑游，可与衡东洣水湿地串联为两日东线。</desc>
    <time>2026-10-16T08:00:00.235031+00:00</time>
  </metadata>
  <wpt lat="26.89647" lon="112.70956">
    <name>衡阳东站</name>
  </wpt>
  <wpt lat="27.10167" lon="113.14283">
    <name>荣桓镇</name>
  </wpt>
  <wpt lat="27.07159" lon="113.15536">
    <name>罗荣桓故里</name>
  </wpt>
