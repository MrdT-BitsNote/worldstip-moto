<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>新化北塔·上梅古镇“梅山文化”资江人文线</name>
    <desc>新化古称“上梅”，是梅山文化发祥地，宋熙宁五年（1072）置县、取“王化之新地”之意；新化北塔位于上梅街道城北资水西岸，是清代古塔、新化古城地标，登塔可俯瞰资江与古城；上梅古镇保留梅山民俗、老街与资江码头文化，资江风光带滨江开阔。本线从珠山公园集合点西行进入新化县城，逛上梅古镇老街、谒北塔、沿资江风光带兜风，是娄底最具梅山文化分量的人文骑游，单程约 70km、可一日往返，可顺访梅山龙宫与大熊山，尝新化三合汤、杯子糕与资江河鲜。</desc>
    <time>2026-10-16T08:00:00.565107+00:00</time>
  </metadata>
  <wpt lat="27.71735" lon="112.02028">
    <name>珠山公园</name>
  </wpt>
  <wpt lat="27.74455" lon="111.30687">
    <name>新化上梅古镇</name>
  </wpt>
  <wpt lat="27.75642" lon="111.30675">
    <name>新化北塔公园</name>
  </wpt>
