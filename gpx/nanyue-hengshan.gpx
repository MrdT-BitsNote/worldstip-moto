  </wpt>
  <wpt lat="27.26931" lon="112.71552">
    <name>南岳衡山风景名胜区</name>
  </wpt>
  <wpt lat="27.27271" lon="112.75096">
    <name>水帘洞景区</name>
  </wpt>
