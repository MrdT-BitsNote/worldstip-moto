<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>南岳衡山五岳独秀朝圣线</name>
    <desc>南岳衡山是五岳之一、世界文化与自然双遗产，以“五岳独秀”著称。本线从衡阳北上约 50km 抵达南岳，串联南岳大庙（南方最大古建筑群之一）、祝圣寺与南岳衡山风景名胜区，并东行水帘洞景区。前山半山亭以上社会车辆/摩托限行需换乘景区车，骑行以公路可达的南岳镇、大庙、水帘洞为主，登顶看云海日出建议换乘或徒步。秋冬看雾凇云海、春季祈福最宜，节假日务必早出发错峰。</desc>
    <time>2026-10-16T08:00:00.128582+00:00</time>
  </metadata>
  <wpt lat="26.91935" lon="112.62777">
    <name>来雁塔</name>
  </wpt>
  <wpt lat="27.24508" lon="112.73431">
    <name>南岳大庙</name>
