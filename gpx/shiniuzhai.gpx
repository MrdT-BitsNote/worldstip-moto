<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>平江石牛寨丹霞地质跑山线</name>
    <desc>石牛寨国家地质公园位于平江东部、湘赣交界，以丹霞地貌、奇峰怪石与高空玻璃桥著称，素有“小张家界”之称。本线从平江县城东行抵达石牛寨，沿途丘陵盘山、丹霞列阵，是岳阳片区最具视觉冲击的攻山+地质奇观长线，建议结伴、控速。</desc>
    <time>2026-10-16T08:00:01.843758+00:00</time>
  </metadata>
  <wpt lat="28.69314" lon="113.59861">
    <name>平江起义纪念馆</name>
  </wpt>
  <wpt lat="28.90255" lon="113.9867">
    <name>石牛寨国家地质公园</name>
  </wpt>
