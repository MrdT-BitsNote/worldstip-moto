<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>铁山水库·大云山深度线</name>
    <desc>铁山水库又名”相思湖”，位于岳阳县新墙河上游、大云山脚下，是湖南最大的人工湖泊，水面面积 6.2 万亩、147 座岛屿星罗棋布，素有”千岛之湖””铁山银河”之称，水质达一级饮用水标准、是岳阳市百万市民的饮用水源地。本线从岳阳市区经岳阳县、公田镇深入铁山水库库区，再沿库区公路北上抵达大云山东南麓，与已有 dayunshan 线（经相思山自东向西登大云山）走法完全不同——本线以铁山水库为核心，从南侧切入大云山，串联湖南”千岛湖”与道教名山的深度骑行。</desc>
    <time>2026-10-16T08:00:01.966884+00:00</time>
  </metadata>
  <wpt lat="29.365" lon="113.12">
    <name>岳阳市区</name>
  </wpt>
