<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>高椅岭丹霞“龙脊背”跑山线</name>
    <desc>高椅岭旅游区位于苏仙区飞天山镇高椅岭村，距郴州市中心约 18 公里，是飞天山旅游区的重要组成部分，以典型丹霞地貌著称，红岩绿水、沟壑纵横、山环水绕，徐霞客游郴时曾赞叹“无寸土不丽，无一山不奇”并镌刻“寸土佳丽”。本线从禁摩区外的白露塘镇集合点东北行进入高椅岭，行走山脊栈道（网红“龙脊背”），解锁湘南丹霞奇绝风光，是郴州近郊最经典的丹霞跑山线，春季樱花谷最宜。</desc>
    <time>2026-10-16T07:59:59.456505+00:00</time>
  </metadata>
  <wpt lat="25.805312" lon="113.13895">
    <name>白露塘镇人民政府</name>
  </wpt>
  <wpt lat="25.95842" lon="113.15945">
    <name>高椅岭旅游区</name>
  </wpt>
