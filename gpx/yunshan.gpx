<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>云山国家森林公园盘山线</name>
    <desc>云山国家森林公园是武冈的“楚南胜境”，千年道观隐于云雾，盘山公路弯绕、海拔抬升明显，是湘西南经典的高山跑山线。本线从禁摩区外的松坡公园出发西南行约 150km 直抵云山，专注盘山弯道与山顶道观云海；武冈都梁古城可作为同向的文化延伸（见“武冈古城·都梁王城线”）。</desc>
    <time>2026-10-16T08:00:02.210029+00:00</time>
  </metadata>
  <wpt lat="27.15144" lon="111.40904">
    <name>松坡公园</name>
  </wpt>
  <wpt lat="26.64815" lon="110.63353">
    <name>云山国家森林公园</name>
  </wpt>
