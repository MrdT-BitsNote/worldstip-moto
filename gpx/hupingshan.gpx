<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>石门壶瓶山“湖南屋脊”生态穿越线</name>
    <desc>壶瓶山位于石门县西北、湘鄂交界，主峰海拔 2098.7m，是“湖南屋脊”、国家级自然保护区，原始森林覆盖率极高，有峡谷、瀑布群、珙桐（中国鸽子花）与猕猴。本线从常德市区西行经石门、龙王洞深入壶瓶山，是常德最硬核的长途生态穿越线，单程约 200km、建议安排两天，夏季避暑、春季观珙桐最宜。</desc>
    <time>2026-10-16T08:00:01.259567+00:00</time>
  </metadata>
  <wpt lat="29.02719" lon="111.69267">
    <name>常德诗墙公园</name>
  </wpt>
