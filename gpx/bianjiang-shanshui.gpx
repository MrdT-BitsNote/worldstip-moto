<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>永兴便江碧水丹霞山水线</name>
    <desc>便江是永兴县母亲河，碧水丹霞、山水相映，沿江有龙王庙、便江漂流与丹霞峰林，被誉为“小漓江”。本线从禁摩区外的许家洞镇集合点北行进入永兴便江，沿碧水丹霞风光带骑行，可乘船赏水上画廊、登岸探丹霞峰林，是郴州最具诗意的亲水骑游，夏季漂流最宜。</desc>
    <time>2026-10-16T07:59:59.471165+00:00</time>
  </metadata>
  <wpt lat="25.880345" lon="113.078506">
    <name>许家洞镇人民政府</name>
  </wpt>
  <wpt lat="26.11891" lon="113.13884">
    <name>便江</name>
  </wpt>
