<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>祁阳浯溪碑林摩崖石刻怀古线</name>
    <desc>浯溪碑林风景名胜区位于祁阳市湘江大桥南端浯溪公园内，濒临湘江、苍崖石壁连绵 78 米，为摩崖文字天然好刻处，现存唐至清摩崖石刻 500 余方，以颜真卿手书《大唐中兴颂》楷体大字最负盛名，是省级爱国主义教育基地与全国重点文保。本线从冷水滩潇湘公园集合点东北行进入祁阳浯溪，赏摩崖碑林、临江怀古，是永州最具分量的碑刻文化骑游，单程约 50km、可半日往返。</desc>
    <time>2026-10-16T08:00:00.894914+00:00</time>
  </metadata>
  <wpt lat="26.42907" lon="111.61674">
    <name>潇湘公园</name>
  </wpt>
  <wpt lat="26.56452" lon="111.84777">
    <name>浯溪碑林风景名胜区</name>
  </wpt>
