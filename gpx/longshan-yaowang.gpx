<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>涟源龙山国家森林公园“岳坪峰药王”盘山线</name>
    <desc>龙山国家森林公园位于涟源市南部，主峰岳坪峰海拔 1558 米，是湘中屋脊般的存在，山顶有纪念药王孙思邈的药王殿，山林原始、云海翻涌，素有“药王故里、湘中名山”之称。本线从珠山公园集合点西南行进入龙山，驰骋盘山弯道、登岳坪峰谒药王殿、看群山层峦与云海，是娄底西南线最经典的高山攻山压弯线，单程约 60km、可一日往返，春赏杜鹃、秋看云海最宜。</desc>
    <time>2026-10-16T08:00:00.524887+00:00</time>
  </metadata>
  <wpt lat="27.71735" lon="112.02028">
    <name>珠山公园</name>
  </wpt>
  <wpt lat="27.50329" lon="111.74651">
    <name>涟源龙山国家森林公园</name>
  </wpt>
