<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>仰天湖大草原“南方最美高山草原”盘山线</name>
    <desc>仰天湖大草原位于北湖区仰天湖瑶族乡，是第四纪冰川期形成的死火山口，平均海拔 1314 米，绿草期长达 9 个月，被誉为“南方最美高山草原”，周边有安源石林、平头山寨、风车、霍比特小屋与草原湖泊。本线从禁摩区外的万华岩集合点西南行进入仰天湖盘山公路，直达大草原景区，是郴州最经典的高山草原攻山压弯线，夏季 20℃ 避暑、秋季南瓜节最宜，上山正在修路弯多，新手注意。</desc>
    <time>2026-10-16T07:59:59.435223+00:00</time>
  </metadata>
  <wpt lat="25.70614" lon="112.93952">
    <name>万华岩风景名胜区</name>
  </wpt>
  <wpt lat="25.5093" lon="112.83538">
    <name>仰天湖大草原景区</name>
  </wpt>
