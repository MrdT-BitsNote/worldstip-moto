<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>汝城温泉·九龙江国家森林公园”华南第一泉”线</name>
    <desc>汝城热水温泉古称”灵泉”，位于湘粤赣三省交界的热水镇，地表水温高达 98℃，含 30 多种对人体有益的微量元素，被誉为”华南第一泉”，早在唐乾元二年即载入国家地理志；九龙江国家森林公园位于汝城县三江口镇，森林覆盖率达 97.4%，有”南岭植物王国”之称，分九龙觅仙、九龙戏水、九龙奇岩、九龙飞瀑和热水温泉五大景区，有 178 米高空玻璃栈道、华南第一瀑青龙瀑与 5 公里古树步道。本线从禁摩区外的王仙岭集合点东南行深入汝城，第一天泡温泉、第二天探森林，是郴州最舒适的”温泉+森林”组合骑游，单程约 130km、建议安排两天一夜。</desc>
    <time>2026-10-16T07:59:59.519605+00:00</time>
  </metadata>
  <wpt lat="25.75035" lon="113.09038">
    <name>王仙岭</name>
  </wpt>
