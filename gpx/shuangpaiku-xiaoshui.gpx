<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>双牌水库潇水湖环湖山水线</name>
    <desc>潇水湖（双牌水库）位于双牌县、潇水上游，是湖南大型人工湖泊之一，湖水漫江碧透、上百里水面平静似镜，“其水比漓江清、比西湖秀”，两岸青山绿波、刀削岩石与如神似佛的峰峦直插水中。本线从零陵古城南行进入双牌潇水湖，沿环湖公路骑行赏高峡平湖、山水画廊，是永州最具诗意的近郊亲水骑游，单程约 40km、可半日往返，夏季避暑、秋冬观平湖最宜，可顺访阳明山。</desc>
    <time>2026-10-16T08:00:00.863252+00:00</time>
  </metadata>
  <wpt lat="26.21437" lon="111.60569">
    <name>零陵古城</name>
  </wpt>
  <wpt lat="25.9615" lon="111.67281">
    <name>双牌水库</name>
  </wpt>
  <trk>
    <name>双牌水库潇水湖环湖山水线</name>
    <type>山林湖泊</type>
