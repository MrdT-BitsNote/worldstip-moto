<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>桃源夷望溪“常德小桂林”山水线</name>
    <desc>夷望溪位于桃源县兴隆街乡，是沅江支流上的山水画廊，山峦叠翠、修竹成荫、绿水悠悠，被誉为“常德小桂林”。本线从常德市区西南行经桃源抵达夷望溪，沿环湖风光带骑行，可乘船赏水上画廊、登岸拾级至峰顶庵庙一览众山小，是常德最具诗意的亲水骑游。</desc>
    <time>2026-10-16T08:00:01.282347+00:00</time>
  </metadata>
  <wpt lat="29.02719" lon="111.69267">
    <name>常德诗墙公园</name>
  </wpt>
  <wpt lat="28.7743" lon="111.42608">
    <name>桃花源古镇</name>
  </wpt>
  <wpt lat="28.81307" lon="111.18602">
    <name>夷望溪景区</name>
  </wpt>
