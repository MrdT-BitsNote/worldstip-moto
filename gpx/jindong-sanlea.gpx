<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>祁阳金洞三公垒瀑布群溯溪线</name>
    <desc>金洞三公垒瀑布群景区位于祁阳市金洞镇桐子山村、金洞管理区林区，以瀑布溯溪、山林休闲为体验核心，多级飞瀑 层叠、溪水清冽、古木参天，负氧离子极高，是永州近郊新评定的森林瀑布胜地。本线从冷水滩潇湘公园集合点东行进入金洞林区，沿溯溪步道赏三公垒瀑布群，是永州最具野趣的亲水骑游，单程约 80km、夏季避暑溯溪最宜。</desc>
    <time>2026-10-16T08:00:00.867844+00:00</time>
  </metadata>
  <wpt lat="26.42907" lon="111.61674">
    <name>潇湘公园</name>
  </wpt>
  <wpt lat="26.17394" lon="112.09909">
    <name>金洞三公垒瀑布群</name>
  </wpt>
