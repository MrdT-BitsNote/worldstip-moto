<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>东安舜皇山老山界瀑布群攻山线</name>
    <desc>舜皇山国家森林公园位于东安县大庙口镇，是南岭山地重要生态屏障，以老山界、瀑布群（二妃晾锦瀑、浣纱瀑等）与阿巴达漂流闻名，森林覆盖率极高、山高谷深、溪水 层叠。本线从冷水滩潇湘公园集合点西行深入舜皇山，直达公园正门与老山界瀑布群，是永州最硬核的长途深山攻山线，单程约 90km、建议安排两天，夏季避暑漂流、春季观瀑最宜，深山信号弱务必结伴。</desc>
    <time>2026-10-16T08:00:00.836799+00:00</time>
  </metadata>
  <wpt lat="26.42907" lon="111.61674">
    <name>潇湘公园</name>
  </wpt>
  <wpt lat="26.397686" lon="111.047944">
    <name>东安舜皇山国家森林公园游客中心</name>
  </wpt>
