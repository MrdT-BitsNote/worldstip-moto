<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>太阳山”玄天第一峰”魔鬼坡跑山线</name>
    <desc>太阳山古称阳山，是武陵山脉向东延伸的最后一座高峰，主峰海拔 568.4m，史称”玄天第一峰”，距常德市区仅 15km，是常德骑手公认的练坡圣地。本线从常德市区北上直插太阳山南坡，挑战”陡的不敢第二次骑”的魔鬼坡道，登顶普光寺（明万历古刹）俯瞰柳叶湖全貌与常德城区，山脚有农家乐腊肉焖黄鳝配山泉米酒，是常德最纯粹的攻山压弯线。</desc>
    <time>2026-10-16T08:00:01.250836+00:00</time>
  </metadata>
  <wpt lat="29.02719" lon="111.69267">
    <name>常德诗墙公园</name>
  </wpt>
