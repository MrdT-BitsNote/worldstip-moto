<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>汝城沙洲“半条被子”红色文化线</name>
    <desc>沙洲红色旅游景区位于汝城县文明瑶族乡沙洲村，是“半条被子”故事发生地——1934 年红军长征途经沙洲，三位女红军把仅有的一条被子剪下半条留给村民徐解秀，谱写军民鱼水深情。本线从禁摩区外的王仙岭集合点东南行深入汝城沙洲，探访半条被子展示馆、沙洲红色旅游景区与瑶族村落，是郴州最具分量的红色文化寻根骑游，单程约 110km、建议安排两天。</desc>
    <time>2026-10-16T07:59:59.480769+00:00</time>
  </metadata>
  <wpt lat="25.75035" lon="113.09038">
    <name>王仙岭</name>
  </wpt>
  <wpt lat="25.53368" lon="113.36223">
    <name>湖南省汝城县沙洲红色旅游景区</name>
  </wpt>
  <wpt lat="25.54493" lon="113.36417">
    <name>半条被子展示馆</name>
  </wpt>
