<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>江永女书·上甘棠·勾蓝瑶寨文化线</name>
    <desc>江永女书是世界唯一的女性专用文字，女书生态博物馆（浦美岛）系统展示女书的起源、字形与传承；上甘棠古村是湘南千年古村、有“忠孝廉洁”摩崖与古桥古宅；勾蓝瑶寨是明清瑶寨、风雨桥与古戏台保存完好。本线从零陵古城西南行深入江永，串联女书博物馆、上甘棠古村与勾蓝瑶寨，是永州最具特色的女性文字+古村瑶寨人文骑游，单程约 150km、建议安排两天。</desc>
    <time>2026-10-16T08:00:00.885208+00:00</time>
  </metadata>
  <wpt lat="26.21437" lon="111.60569">
    <name>零陵古城</name>
  </wpt>
  <wpt lat="25.35481" lon="111.45566">
    <name>女书生态博物馆景区</name>
  </wpt>
  <wpt lat="25.14903" lon="111.18772">
    <name>上甘棠村</name>
  </wpt>
