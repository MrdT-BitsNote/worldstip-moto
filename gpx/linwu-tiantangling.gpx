<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>临武天堂岭”湘粤界山”高山草甸登山线</name>
    <desc>天堂岭（湖南称天头岭）位于临武县与广东连州市交界处，海拔 1711 米，是南岭山脉簸箕系主峰、湘粤界山，山顶有万亩高山草甸、杜鹃花海与云海景观，被誉为”离天空最近的草甸”。本线从禁摩区外极南的临武县城集合点南行入山，经舜峰镇鸭池塘村（海拔 660 米）沿 8 公里机耕路登顶，是郴州最偏远的登山/跑山线，单程约 100km、建议安排两天一夜，4-5 月杜鹃花海、夏秋云海金色草甸最宜。</desc>
    <time>2026-10-16T07:59:59.507659+00:00</time>
  </metadata>
  <wpt lat="25.725" lon="112.564">
    <name>临武县人民政府</name>
  </wpt>
  <wpt lat="25.185" lon="112.478">
    <name>鸭池塘村</name>
  </wpt>
  <wpt lat="25.1878" lon="112.4428">
    <name>天堂岭</name>
  </wpt>
