<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>苏仙岭登高”天下第十八福地”文化登山线</name>
    <desc>苏仙岭位于郴州市苏仙区，独屹于郴江边，主峰海拔 526 米，自古享有”天下第十八福地””湘南胜地”的美称，因汉代苏耽在此修道成仙的传说而驰名海内外。岭上有桃花居、白鹿洞、三绝碑（秦观词《踏莎行·郴州旅舍》+ 苏轼跋 + 米芾书法，中国十大三绝碑之首）、景星观、升仙石、苏仙观（张学良将军曾被幽禁于此）等景点，从山麓到山顶徒步约 2 公里、40 分钟至 1 小时可达。本线从禁摩区外的王仙岭集合点骑行至苏仙岭，徒步登顶俯瞰郴州全城，是郴州最具文化底蕴的登山骑游。注意：苏仙岭位于禁摩区内，须把车停在区外停车场步行进入。</desc>
    <time>2026-10-16T07:59:59.541241+00:00</time>
  </metadata>
  <wpt lat="25.75035" lon="113.09038">
    <name>王仙岭</name>
  </wpt>
  <wpt lat="25.788" lon="113.018">
    <name>苏仙岭风景区</name>
  </wpt>
