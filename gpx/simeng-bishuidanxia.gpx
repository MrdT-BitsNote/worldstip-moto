<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>溆浦思蒙碧水丹霞“屈子行吟”亲水线</name>
    <desc>思蒙碧水丹霞（思蒙国家湿地公园）位于溆浦县思蒙镇，是国家 4A 级景区、入选“新潇湘八景”，素有“小桂林”之誉，十里碧水绕丹峰、丹霞山水绵延铺展，是屈原行吟求索的核心承载地（《山鬼》“深林杳以冥冥兮，乃猨狖之所居”即描摹此地）。本线从迎丰公园集合点东北行进入思蒙，乘船穿行屈子峡、三闾滩赏碧水丹霞，沿河徒步木栈道、湿地观白鹭、打卡桃源洞天与问天台，是怀化最具诗意的亲水骑游，单程约 80km、可一日往返，清晨 8 点班次水雾最佳、全程约 1.5 小时、无过度商业化，可顺访向警予故居纪念馆（车程约 20 分钟）。</desc>
    <time>2026-10-16T07:59:59.802274+00:00</time>
  </metadata>
  <wpt lat="27.56083" lon="109.98558">
    <name>迎丰公园</name>
  </wpt>
  <wpt lat="27.83539" lon="110.51924">
    <name>思蒙碧水丹霞景区</name>
  </wpt>
