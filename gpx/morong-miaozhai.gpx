<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>古丈墨戎苗寨·茶乡近郊兜风环线</name>
    <desc>墨戎苗寨（墨戎鼓镇）位于古丈县墨戎镇、S229 省道旁，是湘西近郊保存完好的苗族村寨、"中国少数民族特色村寨"，以苗鼓、苗银、苗绣与拦门酒著称，吊脚楼依山而建、是吉首至张家界/凤凰旅游线上的热门苗寨打卡点；周边古丈毛尖茶乡梯田连绵。本线从吉首集合点东行，逛墨戎苗寨看苗鼓苗银、品古丈毛尖，穿茶乡田园，再环回市区，是湘西近郊轻松的苗寨茶乡兜风环线，全程约 70km、可半日至一日往返，春采茶、秋看梯田最宜。</desc>
    <time>2026-10-16T07:59:58.885252+00:00</time>
  </metadata>
  <wpt lat="28.25941" lon="109.7004">
    <name>吉首世纪广场</name>
  </wpt>
