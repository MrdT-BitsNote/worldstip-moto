<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>永兴板梁古村明清古村寻根线</name>
    <desc>板梁古村位于永兴县高亭司镇，是湘南保存最完好的明清古村落之一，始建于元末明初，有 360 多栋明清古建筑、古商道、古驿路与宗祠庙宇，被誉为“湘南第一村”。本线从禁摩区外的万华岩集合点西北行进入板梁古村，探访明清古建筑群、古商道与刘氏宗祠，是郴州最具分量的古村寻根骑游，可顺访永兴便江山水。</desc>
    <time>2026-10-16T07:59:59.475499+00:00</time>
  </metadata>
  <wpt lat="25.70614" lon="112.93952">
    <name>万华岩风景名胜区</name>
  </wpt>
  <wpt lat="26.07928" lon="112.86799">
    <name>板梁古村</name>
  </wpt>
