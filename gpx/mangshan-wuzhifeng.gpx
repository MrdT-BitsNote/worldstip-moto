<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>莽山五指峰“湘粤边界”高山攻山线</name>
    <desc>莽山位于宜章县、湘粤交界，是国家级自然保护区与森林公园，主峰五指峰海拔近 1900 米，有金鞭大峡谷、观音古寺、云海霞光与亚热带常绿阔叶林。本线从禁摩区外的五盖山集合点南行深入莽山，直达五指峰景区（全国单线最长、高差千米的五指峰缆车与 8 公里双层悬空栈道），是郴州最硬核的长途高山攻山线，单程约 90km、建议安排两天，夏季避暑、春季观云海最宜。</desc>
    <time>2026-10-16T07:59:59.444218+00:00</time>
  </metadata>
  <wpt lat="25.63725" lon="113.10103">
    <name>五盖山</name>
  </wpt>
  <wpt lat="24.98145" lon="112.88437">
    <name>莽山旅游区国家森林公园</name>
  </wpt>
  <wpt lat="24.9935" lon="112.9718">
    <name>莽山旅游区五指峰景区</name>
  </wpt>
