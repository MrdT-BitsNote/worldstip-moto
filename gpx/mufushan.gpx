<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>平江天岳幕阜山跑山线</name>
    <desc>天岳幕阜山是平江地标、湘鄂赣交界名山，主峰海拔 1596m，为湘北第一高峰。从平江县城北上进入幕阜山国家森林公园，盘山公路弯绕坡长、林深谷幽，是岳阳片区最硬核的攻山压弯长线；山顶可眺三省群山，夏季避暑、秋季红叶最佳，务必结伴、控速、量力而行。</desc>
    <time>2026-10-16T08:00:01.828464+00:00</time>
  </metadata>
  <wpt lat="28.69314" lon="113.59861">
    <name>平江起义纪念馆</name>
  </wpt>
  <wpt lat="28.9796" lon="113.80148">
    <name>天岳幕阜山森林公园</name>
  </wpt>
