<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>双峰九峰山森林公园盘山攻山线</name>
    <desc>九峰山森林公园位于双峰县南部，九峰连绵、林木葱郁，是双峰的登高名山与城市后花园，山间步道、观景台与原始次生林相映，登高可俯瞰双峰丘陵田园。本线从珠山公园集合点南行进入九峰山，驰骋盘山弯道、登山眺远，是娄底南线经典的攻山压弯+森林登高线，单程约 55km、可一日往返，可顺访曾国藩故居富厚堂，春赏山花、秋看层林最宜。</desc>
    <time>2026-10-16T08:00:00.531695+00:00</time>
  </metadata>
  <wpt lat="27.71735" lon="112.02028">
    <name>珠山公园</name>
  </wpt>
  <wpt lat="27.37088" lon="112.33611">
    <name>九峰山森林公园</name>
  </wpt>
  <trk>
    <name>双峰九峰山森林公园盘山攻山线</name>
    <type>攻山压弯</type>
