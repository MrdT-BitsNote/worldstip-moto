<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>涟源飞水涯峡谷瀑布亲水线</name>
    <desc>飞水涯景区位于涟源市杨市镇大坳村，是一处以峡谷、瀑布、溪流与原始次生林为主的生态景区，峡谷幽深、飞瀑流泉、绿树成荫，夏季清凉避暑、可玩水溯溪。本线从珠山公园集合点南行进入飞水涯，沿峡谷兜风、看飞瀑流泉、徒步木栈道亲水，是娄底南线轻松的峡谷亲水骑游，单程约 50km、可一日往返，夏季避暑玩水、春赏山花最宜，可顺访龙山与湄江。</desc>
    <time>2026-10-16T08:00:00.553235+00:00</time>
  </metadata>
  <wpt lat="27.71735" lon="112.02028">
    <name>珠山公园</name>
  </wpt>
  <wpt lat="27.52046" lon="111.81356">
    <name>飞水涯景区</name>
  </wpt>
