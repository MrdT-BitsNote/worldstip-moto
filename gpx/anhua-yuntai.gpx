<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>安化云台山·雪峰湖茶园天路跑山线</name>
    <desc>云台山位于安化县马路镇，是安化黑茶核心产区的高山茶园，山顶万亩茶园层叠、云海翻涌，盘山“茶园天路”弯绕坡长，被誉为安化最美的跑山公路之一；途经的雪峰湖（柘溪水库）湖面开阔、库湾曲折，雪峰湖大桥飞架。本线从益阳城区西行经雪峰湖深入云台山，是益阳最硬核的长途茶园跑山线，单程约 150km、建议两天一夜，春季看茶园新绿与云海最宜。</desc>
    <time>2026-10-16T08:00:01.560564+00:00</time>
  </metadata>
  <wpt lat="28.59293" lon="112.35526">
    <name>益阳古城</name>
  </wpt>
  <wpt lat="28.323656" lon="111.117593">
    <name>雪峰湖旅游码头</name>
  </wpt>
  <wpt lat="28.36225" lon="110.99634">
    <name>云台山风景区</name>
  </wpt>
