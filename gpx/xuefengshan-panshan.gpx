<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>雪峰山国家森林公园“雪峰天险”320国道盘山攻山线</name>
    <desc>雪峰山国家森林公园位于洪江市东部雪峰镇，地处 320 国道旁（320 国道是唯一通往公园的道路），主峰苏宝顶海拔 1934 米，是湖南境内延伸最长的大山、中国地理第二级向第三级过渡的标志性山脉，也是抗日战争最后一战“湘西会战”的主战场。320 国道雪峰山段素称“雪峰天险”，有 331 道弯、26 公里连续爬坡，从雪峰镇到公园全程约 20 公里上坡、下山约 15 公里至塘湾镇，是摩友心中的经典攻山路段。本线从中坡山森林公园集合点东南行经 G320 翻越雪峰山直达公园，赏云海、原始次生林与三千年银杏王，是怀化最硬核的高山攻山压弯线，公园免门票、夏季避暑、五月云雾与十月银杏最宜。</desc>
    <time>2026-10-16T07:59:59.754940+00:00</time>
  </metadata>
  <wpt lat="27.57508" lon="109.95057">
    <name>中坡山森林公园</name>
  </wpt>
  <wpt lat="27.30765" lon="110.4112">
    <name>雪峰山国家森林公园</name>
  </wpt>
