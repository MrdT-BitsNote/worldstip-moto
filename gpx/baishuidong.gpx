<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>白水洞峡谷跑山线</name>
    <desc>白水洞是新邵的国家级风景名胜区，也是离邵阳市区最近的跑山去处，以峡谷、瀑布、一线天与太白亭著称。本线从禁摩区外的洋溪桥出发北上约 18km 进山，山路弯绕、溪瀑相伴，是邵阳摩友下班后或周末半日攻山、看瀑的首选近郊线。</desc>
    <time>2026-10-16T08:00:02.205533+00:00</time>
  </metadata>
  <wpt lat="27.28094" lon="111.49522">
    <name>洋溪桥</name>
  </wpt>
  <wpt lat="27.40823" lon="111.42937">
    <name>白水洞国家级风景名胜区</name>
  </wpt>
