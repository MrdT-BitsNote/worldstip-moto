<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>新化梅山大峡谷·油溪桥村“千年古村”梅山线</name>
    <desc>梅山大峡谷旅游区位于新化县田坪镇，峡谷幽深、绝壁对峙，有玻璃桥、栈道与溪流瀑布，是梅山腹地的峡谷奇观；油溪桥村位于新化县吉庆镇，是有千年历史的古村、全国文明村，保留石板路、古民居与古树，以“公司+农户”乡村振兴模式闻名，村容整洁、田园秀丽。本线从珠山公园集合点东北行进入新化，先走梅山大峡谷玻璃桥与栈道、看峡谷绝壁，再访油溪桥村千年古村、逛石板路古民居，是娄底东北线兼具峡谷奇观与古村人文的骑游，单程约 85km、可一日往返，可顺访梅山龙宫与大熊山。</desc>
    <time>2026-10-16T08:00:00.571609+00:00</time>
  </metadata>
  <wpt lat="27.71735" lon="112.02028">
    <name>珠山公园</name>
  </wpt>
