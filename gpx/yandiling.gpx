<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>炎帝陵祭祖寻根线</name>
    <desc>炎陵是中华民族始祖炎帝神农氏的安寝之地，本线从炎陵县城（红军标语博物馆、洣泉书院）出发，经鹿原镇抵达“神州第一陵”炎帝陵，是株洲南向的祭祖寻根与红色文化骑游。</desc>
    <time>2026-10-16T07:59:58.326544+00:00</time>
  </metadata>
  <wpt lat="26.48804" lon="113.77271">
    <name>红军标语博物馆</name>
  </wpt>
  <wpt lat="26.48985" lon="113.77267">
    <name>炎陵县</name>
  </wpt>
  <wpt lat="26.43102" lon="113.66495">
    <name>鹿原镇人民政府</name>
  </wpt>
  <wpt lat="26.41934" lon="113.67073">
    <name>炎帝陵</name>
  </wpt>
