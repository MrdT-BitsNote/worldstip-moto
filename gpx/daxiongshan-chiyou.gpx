<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>新化大熊山国家森林公园“蚩尤故里”盘山攻山线</name>
    <desc>大熊山国家森林公园位于新化县北部，是蚩尤故里、梅山文化核心地，园内有蚩尤屋场、中华银杏王（树龄逾千年）、原始次生林与飞瀑流泉，主峰九龙峰海拔 1622 米，森林覆盖率极高、夏季清凉避暑。本线从珠山公园集合点北行，先探资江畔的梅山龙宫（九层溶洞、466 米地下暗河），再盘山登上大熊山驰骋原始森林弯道，是娄底北线最经典的高山攻山压弯线；因单程约 170km、深山信号弱，建议安排两天一夜（夜宿梅山龙宫或大熊山景区），夏秋避暑赏银杏最宜。</desc>
    <time>2026-10-16T08:00:00.512950+00:00</time>
  </metadata>
  <wpt lat="27.71735" lon="112.02028">
    <name>珠山公园</name>
  </wpt>
  <wpt lat="27.9472" lon="111.28358">
    <name>梅山龙宫</name>
  </wpt>
  <wpt lat="28.15819" lon="111.29282">
    <name>大熊山国家森林公园</name>
  </wpt>
