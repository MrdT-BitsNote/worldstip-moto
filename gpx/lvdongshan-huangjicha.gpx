<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>保靖吕洞山苗族圣山·黄金茶乡山林线</name>
    <desc>吕洞山位于保靖县，是苗族圣山、因山中天然"吕"字形双洞（相传吕洞宾修炼于此）得名，主峰海拔 1227 米、峰峦叠翠、云海翻涌，是湘西苗族祭祖与朝圣之地，山下苗寨（夯沙、黄金、吕洞等）保留原生态苗俗；保靖黄金茶是中国国家地理标志产品、"一两黄金一两茶"，黄金茶庄园梯田茶海连绵。本线从吉首集合点西北行，登吕洞山看苗族圣山云海、逛黄金茶庄园品保靖黄金茶，是湘西苗族圣山与茶乡结合的山林线，全程约 68km、可一日往返，春采茶、夏避暑、秋看云海最宜。</desc>
    <time>2026-10-16T07:59:58.868184+00:00</time>
  </metadata>
  <wpt lat="28.25941" lon="109.7004">
    <name>吉首世纪广场</name>
  </wpt>
  <wpt lat="28.46284" lon="109.66716">
    <name>吕洞山</name>
  </wpt>
  <wpt lat="28.51183" lon="109.75598">
    <name>保靖黄金茶庄园</name>
  </wpt>
