<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>虎形山·崇木凼花瑶山脊线</name>
    <desc>虎形山是隆回花瑶少数民族聚居的高山台地，崇木凼村是花瑶古寨核心，花瑶挑花为国家级非遗。本线从禁摩区外的洋溪桥出发西北行约 115km，穿越丘陵进入花瑶山脊，古寨、梯田、金银花与云雾交织，是邵阳西北最具民族风情的高山跑山线。</desc>
    <time>2026-10-16T08:00:02.220259+00:00</time>
  </metadata>
  <wpt lat="27.28094" lon="111.49522">
    <name>洋溪桥</name>
  </wpt>
  <wpt lat="27.53833" lon="110.74541">
    <name>崇木凼村</name>
  </wpt>
