<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>麻阳西晃山·长寿谷“天下第一寿山”盘山线</name>
    <desc>西晃山位于麻阳苗族自治县县城西南、属武陵山余脉南麓，主峰金顶海拔 1405 米，有“西晃晴云”“天下第一寿山”之称，一路山奇、水秀、石怪、云幻、林幽、花艳，负氧离子充盈；麻阳是“世界长寿乡”，长寿谷森林茂密、康养宜人。本线从中坡山森林公园集合点西北行经 G209 进入麻阳，沿山路蜿蜒登上西晃山金顶俯瞰湘黔群山层峦叠嶂、云海漫卷，再探长寿谷，是怀化西北线最经典的高山攻山压弯线，单程约 55km、可一日往返，春日赏苗乡花果、秋日看云海最宜，可顺访滕代远同志纪念馆与霞飞云果园。</desc>
    <time>2026-10-16T07:59:59.780988+00:00</time>
  </metadata>
  <wpt lat="27.57508" lon="109.95057">
    <name>中坡山森林公园</name>
