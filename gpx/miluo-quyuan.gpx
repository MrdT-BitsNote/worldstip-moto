<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>汨罗屈子祠·任弼时故里人文线</name>
    <desc>汨罗是屈原投江殉国之地、端午龙舟源头，也是任弼时同志故里。本线从岳阳市区南下，串联玉笥山屈子祠（屈原祠庙、端午文化圣地）与任弼时纪念馆，是一次融合楚辞文化、端午民俗与红色记忆的人文骑游。</desc>
    <time>2026-10-16T08:00:01.939992+00:00</time>
  </metadata>
  <wpt lat="29.37384" lon="113.09302">
    <name>巴陵广场</name>
  </wpt>
  <wpt lat="28.88011" lon="113.04376">
    <name>屈子祠</name>
  </wpt>
  <wpt lat="28.51768" lon="113.14564">
    <name>任弼时纪念馆</name>
  </wpt>
