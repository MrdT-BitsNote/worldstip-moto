<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>新化紫鹊界梯田·正龙古村“世界双遗产”梯田线</name>
    <desc>紫鹊界梯田位于新化县水车镇，始于秦汉、盛于宋明，已有 2000 余年历史，是苗、瑶、侗、汉多民族先民共同开垦的杰作，2014 年入选首批世界灌溉工程遗产、2018 年被联合国粮农组织认定为全球重要农业文化遗产，是湖南唯一拥有世界“双遗产”头衔的景区；梯田总面积 26 万余亩、核心区 8 万亩以上，海拔 500-1200 米、坡度 30-50 度、共 500 余级，无坝自流灌溉（“山有多高、水有多高、田就有多高”），素有“梯田王国”“地球最美指纹”之誉。正龙古村紧邻梯田，保留百年干栏式板屋群与吊脚楼。本线从珠山公园集合点西北行深入紫鹊界，驰骋盘山梯田公路、看层层梯田与日出云海、逛正龙古村，是娄底最具分量的世界双遗产骑游，单程约 115km、路程较远建议早出发或安排两天，春灌水期如镜、金秋稻浪最宜。</desc>
    <time>2026-10-16T08:00:00.538442+00:00</time>
  </metadata>
  <wpt lat="27.71735" lon="112.02028">
    <name>珠山公园</name>
  </wpt>
