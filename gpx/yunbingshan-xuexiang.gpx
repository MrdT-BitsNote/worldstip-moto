<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>蓝山云冰山“南方雪乡”盘山线</name>
    <desc>云冰山旅游区位于蓝山县、湘粤交界，平均海拔 1200 余米，四季景观分明，以冬季雾凇冰挂“南方雪乡”、夏季云海避暑著称，有玻璃桥、云端栈道与原始次生林。本线从零陵古城南行深入蓝山云冰山，是永州最硬核的长途高山盘山线，单程约 130km、建议安排两天，冬季赏雾凇、夏季避暑观云海最宜，山区冬季易结冰务必结伴控速。</desc>
    <time>2026-10-16T08:00:00.843270+00:00</time>
  </metadata>
  <wpt lat="26.21437" lon="111.60569">
    <name>零陵古城</name>
  </wpt>
  <wpt lat="25.19249" lon="112.21665">
    <name>云冰山旅游区</name>
  </wpt>
