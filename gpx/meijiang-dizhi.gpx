<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>涟源湄江国家地质公园“湘中小桂林”岩溶山水线</name>
    <desc>湄江国家地质公园位于涟源市西北部、距娄底约 50 公里，是国家 4A 级景区、湘中唯一的国家地质公园，以喀斯特低山岩溶地貌为主，素有“湘中小桂林”“三湘一秀”“楚湘奇观”之誉；九曲湄江串联大江口、观音崖—藏君洞、塞海湖—龙泉峡、仙人府—香炉峰等景区，拥有香炉山“天弹待发”（巨石重约 10 吨、斜立崖顶、接触面仅 50cm²、一人可摇动）、仙人府天生桥（单拱高 40 米、双拱高 50 米，双孔形似“M”单孔形似“J”合为“湄江”）、观音崖“莲花涌泉”、塞海湖岩溶湖与十里画壁（黄罗湾壁长 3500 米、相对高差 360 米、“三湘一绝”）等世界稀有地质遗迹。本线从珠山公园集合点西北行进入湄江，沿九曲湄江兜风、看塞海湖碧水丹霞、登香炉山拍湄江全景、走揽月古道贴十里画壁，是娄底最具特色的岩溶山水骑游，单程约 60km、可一日往返，夏季均温 18℃清凉、丰水期碧波最宜。</desc>
    <time>2026-10-16T08:00:00.547890+00:00</time>
  </metadata>
  <wpt lat="27.71735" lon="112.02028">
    <name>珠山公园</name>
  </wpt>
  <wpt lat="27.90621" lon="111.7451">
    <name>湄江国家地质公园</name>
  </wpt>
