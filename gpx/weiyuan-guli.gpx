<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>魏源故居湖湘风骨线</name>
    <desc>魏源是近代“睁眼看世界”的先驱、《海国图志》作者，提出“师夷长技以制夷”，其故里在隆回县司门前镇。本线从禁摩区外的洋溪桥出发西北行约 86km，寻访魏源故居，沿途为湘中丘陵田园，是邵阳西北向的中距离人文骑游。</desc>
    <time>2026-10-16T08:00:02.265126+00:00</time>
  </metadata>
  <wpt lat="27.28094" lon="111.49522">
    <name>洋溪桥</name>
  </wpt>
  <wpt lat="27.46946" lon="110.90028">
    <name>魏源故居</name>
  </wpt>
