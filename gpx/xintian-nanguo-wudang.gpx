<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>新田南国武当山喀斯特峰林线</name>
    <desc>南国武当山位于新田县石羊镇，总面积 46 平方公里，因地处湖北武当山之南得名，主峰白面峰海拔 688 米，属典型喀斯特地貌，分布 108 座形态各异的石灰岩峰丛，有"险如蚕丛"之称；境内现存唐宋至明清时期的道观佛殿寺庙遗址 6 处，保留摩崖石刻、石碑百余块，有"南国第一泉"鹅井等泉井 118 眼，山间保留石古寨等古军事要塞 3 处，云雾景观随季节变化呈现烟波浩渺、丝滑流淌的视觉效果。本线从零陵古城东南行深入新田南国武当山，探喀斯特峰林、道教遗址与云雾奇观，是永州最具野趣的东南向骑游，单程约 130km、建议安排两天。</desc>
    <time>2026-10-16T08:00:00.916097+00:00</time>
  </metadata>
  <wpt lat="26.21437" lon="111.60569">
    <name>零陵古城</name>
  </wpt>
  <wpt lat="25.701" lon="112.201">
    <name>南国武当山</name>
  </wpt>
