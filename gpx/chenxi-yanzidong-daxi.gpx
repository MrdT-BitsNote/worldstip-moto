<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>辰溪燕子洞·大酉山岩溶山水线</name>
    <desc>燕子洞景区位于辰溪县火马冲镇、距怀化五十余公里，属岩溶地貌，山势险峻、沟壑幽深、林木葱茏、溪水淙淙，有悬崖峭壁的“一线天”、险峻幽深的燕子洞、高峡平湖与玉龙湖泛舟，以及绝壁琴钟、玉清池、三贤鼎立、天生桥等三十余处景观，沟、水、洞、林兼备，雄、奇、秀、幽毕集；大酉山位于辰阳古城南面，是辰溪的道教文化名山与城市后花园，山有大酉观，登高可俯瞰辰阳古城与沅水风光。本线从迎丰公园集合点东北行进入辰溪，探燕子洞岩溶奇观、登大酉山眺沅水，是怀化东北线最具特色的山水骑游，单程约 50km、可一日往返，春来杜鹃漫山、秋日菊花满谷最宜。</desc>
    <time>2026-10-16T07:59:59.794590+00:00</time>
  </metadata>
  <wpt lat="27.56083" lon="109.98558">
    <name>迎丰公园</name>
  </wpt>
  <wpt lat="27.85706" lon="110.26328">
    <name>燕子洞</name>
  </wpt>
  <wpt lat="27.97441" lon="110.15081">
    <name>大酉山</name>
  </wpt>
