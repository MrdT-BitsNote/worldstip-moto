<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>资兴回龙山瑶族森林云海线</name>
    <desc>回龙山位于资兴市回龙山瑶族乡，主峰海拔 1300 余米，森林覆盖率极高，以高山云海、日出、原始次生林与瑶族村寨著称，是资兴东江湖片区之外的“云端秘境”。本线从禁摩区外的白露塘镇集合点东北行盘山深入回龙山，是郴州中东向最经典的高山森林云海骑游，单程约 50km、夏季避暑、秋冬观云海日出最宜，山顶信号弱务必结伴。</desc>
    <time>2026-10-16T07:59:59.464793+00:00</time>
  </metadata>
  <wpt lat="25.805312" lon="113.13895">
    <name>白露塘镇人民政府</name>
  </wpt>
  <wpt lat="26.058337" lon="113.40334">
    <name>东江湖回龙山景区</name>
  </wpt>
