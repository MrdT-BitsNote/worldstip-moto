<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>澧县城头山“中国最早城市”寻根线</name>
    <desc>城头山国家考古遗址公园位于澧县，是迄今中国发现最早的城址（距今约 6000 年），被誉为“中国最早的城市”，并发现世界最早的水稻田。本线从常德市区北上至澧县城头山，探访 6000 年前城墙遗迹、体验古法陶艺，是常德最具分量的史前文明寻根骑游，可顺访澧阳平原史前遗址群。</desc>
    <time>2026-10-16T08:00:01.295031+00:00</time>
  </metadata>
  <wpt lat="29.02719" lon="111.69267">
    <name>常德诗墙公园</name>
  </wpt>
  <wpt lat="29.66893" lon="111.66015">
    <name>城头山国家考古遗址公园</name>
