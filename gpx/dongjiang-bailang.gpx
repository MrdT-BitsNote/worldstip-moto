<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>东江湖·雾漫小东江·白廊环湖线</name>
    <desc>东江湖是国家 5A 级景区、郴州山水名片，核心景点雾漫小东江以清晨江面薄雾缥缈、渔夫撒网的水墨仙境著称（雾气源于 150 米深、常年 8-10℃ 的底层江水），白廊环湖路被誉为郴州“小洱海”，碧水连天、可环湖骑行。本线从禁摩区外的郴州长卷集合点东行进入东江湖，串联东江湖旅游区、雾漫小东江与白廊环湖，是郴州最具诗意的亲水骑游，4-10 月清晨观雾最宜。</desc>
    <time>2026-10-16T07:59:59.459583+00:00</time>
  </metadata>
  <wpt lat="25.77443" lon="113.12314">
    <name>郴州长卷</name>
  </wpt>
  <wpt lat="25.93442" lon="113.26415">
    <name>东江湖旅游区</name>
  </wpt>
  <wpt lat="25.91364" lon="113.27931">
    <name>雾漫小东江</name>
  </wpt>
  <wpt lat="25.91672" lon="113.39916">
    <name>东江湖景区白廊景区</name>
  </wpt>
