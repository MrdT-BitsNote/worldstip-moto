<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>泸溪浦市古镇沅江千年商埠人文线</name>
    <desc>浦市古镇位于泸溪县沅江中游西岸，是湘西四大名镇之一、有"小南京""湘西第一古镇"之称，明清为沅江中游最大商贸重镇与"茶马古道""西南丝绸之路"水陆码头，古街、码头、会馆与吉家大院保存完好，沅江风光带曲流开阔。本线从吉首集合点东南行，逛浦市古镇石板老街与沅江古码头、看会馆商号与沅江曲流，是湘西沅江商埠文化的轻松人文线，单程约 96km、可一日往返，春看沅江、秋赏古镇最宜；泸溪天桥山（天然石桥与古刹）与沅江风光带可作延伸。</desc>
    <time>2026-10-16T07:59:58.851453+00:00</time>
  </metadata>
  <wpt lat="28.25941" lon="109.7004">
    <name>吉首世纪广场</name>
  </wpt>
  <wpt lat="28.09072" lon="110.10704">
    <name>浦市古镇</name>
  </wpt>
