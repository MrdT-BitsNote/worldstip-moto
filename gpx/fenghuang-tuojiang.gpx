<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="worldstip-travel-planner v0.1.12"
     xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>凤凰古城·沈从文故居·沱江吊脚楼"边城"人文线</name>
    <desc>凤凰古城是国家 5A 级景区、中国第 101 座国家历史文化名城，沱江穿城而过、两岸吊脚楼临水而建，是沈从文笔下的"边城"、民国总理熊希龄与国画大师黄永玉的故乡。本线从州府吉首集合点南行约 49km 抵凤凰，游沈从文故居、熊希龄故居，漫步青石板街、看虹桥与南华桥夜景、沱江泛舟赏吊脚楼倒影，是湘西最经典的人文漫游线，全程约 49km、可一日往返（夜宿凤凰看夜景更佳），四季皆宜、夜景最动人。</desc>
    <time>2026-10-16T07:59:58.834632+00:00</time>
  </metadata>
  <wpt lat="28.25941" lon="109.7004">
    <name>吉首世纪广场</name>
  </wpt>
  <wpt lat="27.94893" lon="109.60627">
    <name>凤凰古城</name>
  </wpt>
